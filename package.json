{
  "name": "print-hub",
  "version": "1.0.0",
  "description": "Print Hub - Offline Desktop Print Server",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "concurrently \"vite --config src/renderer/vite.config.js\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:server": "node src/server/standalone.js",
    "dev:frontend": "vite --config src/renderer/vite.config.js",
    "build:renderer": "vite build --config src/renderer/vite.config.js",
    "build": "npm run build:renderer && electron-builder --win",
    "start": "electron .",
    "start:server": "node src/server/standalone.js"
  },
  "dependencies": {
    "bonjour": "^3.5.1",
    "call-bind-apply-helpers": "^1.0.2",
    "cors": "^2.8.5",
    "electron-store": "^8.2.0",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "node-schedule": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "sql.js": "^1.11.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.27.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.printhub.app",
    "productName": "Print Hub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "release/frontend/**/*",
      "node_modules/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "signAndEditExecutable": false,
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
